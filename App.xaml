<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NET11SDK"
             x:Class="NET11SDK.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontImageSource x:Key="GlyphV" Color="Black" Glyph="V"/>
            <FontImageSource x:Key="GlyphW" Color="Black" Glyph="W"/>
            <FontImageSource x:Key="GlyphX" Color="Black" Glyph="X"/>
            <FontImageSource x:Key="GlyphY" Color="Black" Glyph="Y"/>
            <FontImageSource x:Key="GlyphZ" Color="Black" Glyph="Z"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
